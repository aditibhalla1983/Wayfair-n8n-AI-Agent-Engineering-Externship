    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# 1. Get the input prompt from the first item\ninput_prompt = _items[0][\"json\"].get('output', '') or ''\n\n# 2. Remove line breaks (replace with a space)\nclean_prompt = \" \".join(input_prompt.splitlines())\n\n# 3. Remove Markdown (** and * bullets)\nclean_prompt = clean_prompt.replace(\"**\", \"\").replace(\"*\", \"\")\n\n# 4. Replace double quotes with single quotes\nclean_prompt = clean_prompt.replace('\"', \"'\")\n\n# 5. Build n8n-compatible return\nreturn [\n  {\n    \"json\": {\n      \"prompt\": clean_prompt\n    }\n  }\n]\n"
