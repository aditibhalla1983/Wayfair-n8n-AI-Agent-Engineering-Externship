    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# Convert Cloudflare Workers AI JSON response (base64) into a downloadable image file\nimport base64\n\nitems = _items\nresults = []\n\nfor item in items:\n    # works whether \"Full Response\" is on or off\n    item_json = item.get(\"json\", {})\n    \n    # Check if 'result' is at the root level, otherwise look inside 'body'\n    body = item_json if \"result\" in item_json else item_json.get(\"body\", {})\n    \n    # Safely extract the base64 text string from result dictionary\n    result_data = body.get(\"result\", {}) if isinstance(body, dict) else {}\n    base64_str = result_data.get(\"image\", \"\") if isinstance(result_data, dict) else \"\"\n\n    if not base64_str:\n        # Throw an error if the base64 string is missing\n        raw_json_preview = str(item_json)[:200]\n        raise ValueError(f\"No image found in response: {raw_json_preview}\")\n\n    # Decode the text string back into raw bytes (equivalent to JavaScript Buffer)\n    image_bytes = base64.b64decode(base64_str)\n\n    # Reconstruct the n8n item format\n    output_item = {\n        \"json\": {\n            \"fileName\": \"moodboard.jpg\",\n            \"mimeType\": \"image/jpeg\",\n            \"sizeBytes\": len(image_bytes)\n        },\n        \"binary\": {\n            # Use n8n's native python setter to package the image file bytes\n            \"data\": this.setBinaryData(image_bytes, \"moodboard.jpg\", \"image/jpeg\")\n        }\n    }\n    \n    results.append(output_item)\n\nreturn results\n"
      },
